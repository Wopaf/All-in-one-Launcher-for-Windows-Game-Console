<v:OverlayBase x:Class="MaRogAlly.Views.DetailView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="clr-namespace:MaRogAlly.UI"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <v:OverlayBase.Resources>
        <!-- Capture d'écran : cadre blanc et léger zoom quand elle est sélectionnée -->
        <Style x:Key="ShotButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale"/>
                            </Grid.RenderTransform>
                            <Border ui:Rounded.Radius="10" Background="#1A1F2A">
                                <Grid>
                                    <!-- Carte fantôme qui respire tant que l'image n'est pas arrivée (l'image la recouvre ensuite) -->
                                    <Border x:Name="Pulse" Background="#3A4252" Opacity="0.25"/>
                                    <Image Source="{Binding}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <Border x:Name="Frame" CornerRadius="10" BorderThickness="3" BorderBrush="White" Opacity="0" Margin="-1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="Pulse">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="Opacity" From="0.25" To="0.85"
                                                         Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever">
                                            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Section entière sélectionnable (description, succès) : un cadre l'entoure.
             Marges opposées au Padding : le contenu reste aligné sur le reste de la fiche, le cadre déborde autour. -->
        <Style x:Key="SectionButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Template">
                <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Fill" CornerRadius="16" Background="Transparent"/>
                        <Border x:Name="Frame" CornerRadius="16" BorderBrush="#E6FFFFFF" BorderThickness="2" Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#0AFFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="#12FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </v:OverlayBase.Resources>
    <Grid>
        <!-- Assombrit le fond (le visuel du jeu reste visible à droite) -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F20A0C11" Offset="0"/>
                    <GradientStop Color="#CC0A0C11" Offset="0.55"/>
                    <GradientStop Color="#550A0C11" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid x:Name="Body" Margin="64,56,64,56" VerticalAlignment="Center" MaxWidth="1600" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo ou titre -->
            <Grid x:Name="LogoBox" Height="190" HorizontalAlignment="Left" MaxWidth="760">
                <Image ui:ImageLoader.Source="{Binding LogoPath}" ui:ImageLoader.DecodeWidth="900" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
                    </Image.Effect>
                </Image>
                <TextBlock x:Name="TitleText" Text="{Binding DisplayTitle}" Style="{StaticResource H1}" FontSize="50" TextWrapping="Wrap"
                           VerticalAlignment="Bottom" Visibility="{Binding LogoPath, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
            </Grid>

            <!-- Méta -->
            <WrapPanel x:Name="MetaRow" Grid.Row="1" Margin="0,18,0,0">
                <Border CornerRadius="6" Padding="10,4" Margin="0,0,16,0"
                        Background="{Binding PlatformInfo.Color, Converter={StaticResource ColorBrush}, ConverterParameter=0.18}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding PlatformInfo.Logo}" Fill="White" Stretch="Uniform" Width="15" Height="15"
                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PlatformInfo.Name}" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                                   FontSize="14" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding Rating, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding RatingText}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="/100" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="2,2,0,0"/>
                </StackPanel>
                <!-- Temps de jeu (Steam, GOG Galaxy ou API Steam) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding PlaytimeText, Converter={StaticResource VisibleIf}}">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding PlaytimeText}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Taille : place prise sur le disque, ou espace demandé par Steam (rempli après coup) -->
                <StackPanel x:Name="SizePanel" Orientation="Horizontal" Margin="0,0,16,0" Visibility="Collapsed">
                    <TextBlock Text="&#xEDA2;" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="SizeText" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding GenresText}" FontSize="15" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- Actions : « Jouer », puis des boutons ronds (ou, pour un jeu non possédé, les liens vers les magasins) -->
            <StackPanel x:Name="Actions" Grid.Row="2" Orientation="Horizontal" Margin="0,26,0,0">
                <Button x:Name="SteamButton" Style="{StaticResource PillButton}" Click="Steam_Click" Background="#33FFFFFF" Height="48" Padding="26,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="SteamLogo" Fill="White" Stretch="Uniform" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Voir sur Steam" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="InstantGamingButton" Style="{StaticResource PillButton}" Click="InstantGaming_Click" Background="#33FFFFFF" Height="48" Padding="26,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BF;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Voir les offres Instant Gaming" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="WishButton" Style="{StaticResource PillButton}" Click="Wish_Click" Background="#33FFFFFF" Height="48" Padding="26,0" Margin="12,0,0,0"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="WishIcon" Text="&#xEB51;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="WishText" Text="Ajouter à ma liste" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Grid x:Name="PlayBox" Margin="0,0,12,0">
                    <Button x:Name="PlayButton" Style="{StaticResource PillButton}" Click="Play_Click" Background="#33FFFFFF" Height="48" Padding="26,0" Margin="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="PlayIcon" Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="PlayText" Text="Jouer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <!-- Trait lumineux qui fait une fois le tour du bouton quand il est sélectionné.
                         Agrandi comme le bouton sélectionné (×1,06). -->
                    <Rectangle x:Name="PlaySweep" Panel.ZIndex="2" Stroke="White" StrokeThickness="3" StrokeDashCap="Round" Opacity="0"
                               IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><ScaleTransform ScaleX="1.06" ScaleY="1.06"/></Rectangle.RenderTransform>
                        <Rectangle.Effect>
                            <DropShadowEffect Color="White" BlurRadius="14" ShadowDepth="0" Opacity="1"/>
                        </Rectangle.Effect>
                    </Rectangle>
                </Grid>
                <Button x:Name="PlatformButton" Style="{StaticResource RoundButton}" Click="Platform_Click">
                    <Path Data="{Binding PlatformInfo.Logo}" Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                </Button>
                <Button x:Name="FolderButton" Style="{StaticResource RoundButton}" Click="Folder_Click" ToolTip="Ouvrir le dossier">
                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource RoundButton}" Click="Refresh_Click" ToolTip="Actualiser la fiche">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="16"/>
                </Button>
                <Button Style="{StaticResource RoundButton}" Click="Hide_Click" ToolTip="Masquer">
                    <TextBlock x:Name="HideIcon" Text="&#xED1A;" FontFamily="{StaticResource Icons}" FontSize="16"/>
                </Button>
                <Button x:Name="UninstallButton" Style="{StaticResource RoundButton}" Click="Uninstall_Click" ToolTip="Désinstaller">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="16"/>
                </Button>
            </StackPanel>
            <TextBlock x:Name="ActionLabel" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,-24"
                       FontSize="13" Foreground="{StaticResource TextMuted}"/>

            <!-- Description : quelques lignes ; toute la section se sélectionne et s'ouvre en plein écran -->
            <Button x:Name="DescButton" Grid.Row="3" Style="{StaticResource SectionButton}" Margin="-12,30,0,-10" Click="DescButton_Click"
                    Visibility="{Binding Description, Converter={StaticResource VisibleIf}}">
                <TextBlock x:Name="DescText" Text="{Binding Description}" Style="{StaticResource BodyText}" FontSize="17" LineHeight="27"
                           LineStackingStrategy="BlockLineHeight" MaxWidth="820" HorizontalAlignment="Left" TextTrimming="WordEllipsis"/>
            </Button>

            <!-- Captures : sélectionnables, A les agrandit -->
            <!-- Fiche technique : sous la description, sur une grille de petites infos à icône -->
            <Border x:Name="InfoSection" Grid.Row="4" Margin="0,30,0,0" Padding="0,22,0,0" MaxWidth="860" HorizontalAlignment="Left"
                    BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0">
                <WrapPanel x:Name="InfoList"/>
            </Border>

            <!-- Succès du jeu : progression et quelques succès mis en avant ; toute la section se sélectionne et mène à l'onglet Succès. -->
            <Button x:Name="AchievementSection" Grid.Row="5" Style="{StaticResource SectionButton}" Width="884" Margin="-12,-6,0,-10"
                    Visibility="Collapsed" HorizontalContentAlignment="Stretch" Click="AchievementSection_Click">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SUCCÈS" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBlock x:Name="AchievementCount" Grid.Column="1" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Grid x:Name="AchievementBar" Grid.Column="2" Width="170" Height="5" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border CornerRadius="2.5" Background="#1FFFFFFF"/>
                            <Border x:Name="AchievementFill" CornerRadius="2.5" HorizontalAlignment="Left" Background="#E6FFFFFF"/>
                        </Grid>
                        <TextBlock Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    </Grid>
                    <UniformGrid x:Name="AchievementCards" Rows="1" Columns="3" Margin="0,8,-10,0"/>
                </StackPanel>
            </Button>

            <!-- Galerie : captures -->
            <StackPanel x:Name="Gallery" Grid.Row="6" Orientation="Horizontal" Margin="0,22,0,0" VerticalAlignment="Top">
            <ItemsControl x:Name="Shots" Focusable="False" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ShotButton}" Click="Shot_Click" Margin="0,0,14,0"
                                Width="{Binding ShotWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Height="{Binding ShotHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>

        </Grid>

        <!-- Visionneuse plein écran des captures -->
        <Grid x:Name="Lightbox" Background="#F2050608" Visibility="Collapsed" MouseLeftButtonUp="Lightbox_Click">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Deux images en fondu enchaîné ; centrées à leur taille réelle, l'arrondi suit leurs bords -->
            <Image x:Name="LightboxA" Margin="64,36,64,18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   ui:Rounded.Radius="16" RenderOptions.BitmapScalingMode="HighQuality"/>
            <Image x:Name="LightboxB" Margin="64,36,64,18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                   ui:Rounded.Radius="16" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0"/>
            <!-- Carrousel de toutes les captures ; la sélectionnée est encadrée -->
            <ScrollViewer x:Name="StripScroll" Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          Focusable="False" HorizontalAlignment="Center" Margin="64,0,64,26">
                <Grid Margin="6">
                    <StackPanel x:Name="Strip" Orientation="Horizontal"/>
                    <!-- Cadre de sélection : glisse d'une vignette à l'autre -->
                    <Border x:Name="StripFrame" HorizontalAlignment="Left" CornerRadius="10" BorderThickness="2" BorderBrush="White" IsHitTestVisible="False">
                        <Border.RenderTransform><TranslateTransform x:Name="StripFrameMove"/></Border.RenderTransform>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Description en plein écran -->
        <Grid x:Name="DescReader" Background="#F2050608" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource H1}" FontSize="34" TextWrapping="Wrap" Margin="64,36,128,20"/>
            <!-- Pour le doigt et la souris : la sélection à la manette reste sur la section, B referme -->
            <Button Style="{StaticResource RoundButton}" Focusable="False" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,30,48,0"
                    ToolTip="Fermer" Click="CloseReader_Click">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="16"/>
            </Button>
            <ScrollViewer x:Name="ReaderScroll" Grid.Row="1" Margin="64,0" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" FontSize="18" LineHeight="30" LineStackingStrategy="BlockLineHeight"
                           MaxWidth="1000" HorizontalAlignment="Left" Margin="0,0,0,80"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</v:OverlayBase>
