<UserControl x:Class="MaRogAlly.Views.PlatformsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MaRogAlly.UI"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <!-- Bouton d'action cliquable (souris / tactile) ; à la manette on passe par A et Y -->
        <Style x:Key="ActionChip" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="24" Padding="10,9,22,9" Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ====== Halo et filigrane à la couleur de la plateforme ====== -->
        <Ellipse x:Name="Glow" Width="1300" Height="1300" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-620,-420,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowStop" Color="#661B9FFF" Offset="0"/>
                    <GradientStop x:Name="GlowEnd" Color="#001B9FFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Path x:Name="Watermark" Width="680" Height="680" Stretch="Uniform" Fill="White" Opacity="0.035"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-80,40" IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="-12"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Path.RenderTransform>
        </Path>

        <Grid Margin="64,8,64,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== Liste des plateformes ====== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="18,0,0,18">
                    <TextBlock x:Name="ListTitle" Text="Plateformes" Style="{StaticResource H1}" FontSize="34"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource BodyText}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <!-- Fondu en bas de la liste : masque vers la transparence (le fond reste visible) -->
                <ScrollViewer x:Name="ListScroll" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <ScrollViewer.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="0.85"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </ScrollViewer.OpacityMask>
                    <Grid x:Name="ListHost" Margin="0,0,0,60">
                        <Border x:Name="ListHighlight" CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="2"/>
                        <StackPanel x:Name="List"/>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ====== Vitrine de la plateforme sélectionnée ====== -->
            <!-- Marge négative compensée dans le contenu : la zone qui défile ne coupe pas le halo du logo à gauche -->
            <ScrollViewer Grid.Column="2" Margin="-48,0,0,0" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <StackPanel x:Name="Showcase" Margin="48,44,0,40">
                    <Border x:Name="LogoBadge" Width="88" Height="88" HorizontalAlignment="Left">
                        <Path x:Name="BigLogo" Width="88" Height="88" Stretch="Uniform" Fill="White" HorizontalAlignment="Left">
                            <Path.Effect>
                                <DropShadowEffect x:Name="LogoGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.9"/>
                            </Path.Effect>
                        </Path>
                    </Border>

                    <TextBlock x:Name="NameText" Style="{StaticResource H1}" FontSize="58" Margin="0,26,0,0"/>
                    <TextBlock x:Name="TaglineText" Style="{StaticResource BodyText}" FontSize="19" Margin="0,2,0,0"/>

                    <Border x:Name="StatusChip" CornerRadius="15" Padding="12,6,14,6" Margin="0,20,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Chiffres clés -->
                    <Grid x:Name="StatsGrid" Margin="0,34,0,0" MaxWidth="720" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="InstalledCount" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="INSTALLÉS" Style="{StaticResource Label}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="OwnedCount" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="DANS LA BIBLIOTHÈQUE" Style="{StaticResource Label}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock x:Name="HoursCount" Style="{StaticResource StatValue}"/>
                            <TextBlock Text="HEURES DE JEU" Style="{StaticResource Label}"/>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="RatioBar" Width="640" Height="4" HorizontalAlignment="Left" Margin="0,22,0,0">
                        <Border CornerRadius="2" Background="#1FFFFFFF"/>
                        <Border x:Name="RatioFill" CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                    </Grid>
                    <TextBlock x:Name="RatioText" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,8,0,0"/>

                    <!-- Aperçu des jeux -->
                    <TextBlock x:Name="GamesLabel" Style="{StaticResource Label}" Margin="0,34,0,12"/>
                    <ItemsControl x:Name="Covers" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,14,0" ui:Rounded.Radius="10" Background="#1A1F2A">
                                    <TextBlock Text="{Binding DisplayTitle}" Margin="10" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" TextTrimming="WordEllipsis"/>
                                    <Image ui:ImageLoader.DecodeWidth="240" ui:ImageLoader.Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoGamesText" Style="{StaticResource BodyText}" FontSize="15" Visibility="Collapsed"/>

                    <!-- Actions -->
                    <StackPanel x:Name="ActionsRow" Orientation="Horizontal" Margin="0,34,0,0">
                        <Button Style="{StaticResource ActionChip}" Click="Launcher_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource PadGlyph}" Margin="0,0,10,0">
                                    <TextBlock Text="Y" Style="{StaticResource PadGlyphText}" Foreground="#FFD24D"/>
                                </Border>
                                <TextBlock x:Name="LauncherText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
