<v:OverlayBase x:Class="MaRogAlly.Views.KeyboardPanel"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <v:OverlayBase.Resources>
        <!-- Touche : relief discret ; le cadre de sélection à la couleur d'accent glisse derrière les touches -->
        <Style x:Key="Key" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="62"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Relief : un liseré clair en haut, plus sombre en bas -->
                            <Border x:Name="Bd" CornerRadius="14" Background="{TemplateBinding Background}" BorderThickness="0,1,0,3">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#40000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <!-- Sélectionnée : le fond laisse voir le cadre d'accent -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Touches de fonction : un peu plus sombres que les lettres -->
        <Style x:Key="FnKey" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <!-- Valider : toujours à la couleur d'accent -->
        <Style x:Key="OkKey" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </v:OverlayBase.Resources>

    <Grid>
        <!-- Voile : léger en haut, plus dense vers le clavier -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66000000" Offset="0"/>
                    <GradientStop Color="#D9000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Clavier collé aux bords de l'écran (bas, gauche, droite) : les aides de la manette passent en haut -->
        <Border x:Name="Panel" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                CornerRadius="28,28,0,0" Background="{DynamicResource PanelBg}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                Padding="26,20,26,16" ClipToBounds="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black"/>
            </Border.Effect>
            <Grid>
                <!-- Lueur d'accent derrière le champ de saisie -->
                <Ellipse Height="160" Width="700" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-110,0,0" IsHitTestVisible="False" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <StackPanel>
                    <!-- Titre et champ de saisie -->
                    <Grid Margin="5,0,5,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TitleText" Style="{StaticResource Label}" FontSize="13" VerticalAlignment="Center" Margin="4,0,18,0"/>
                        <Border Grid.Column="1" CornerRadius="16" Background="#1AFFFFFF" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Padding="20,0" Height="56">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ValueText" FontFamily="{StaticResource Display}" FontSize="26" Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <!-- Curseur qui clignote -->
                                    <Border x:Name="Caret" Width="2" Height="28" Margin="3,0,0,0" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                                        <Border.Triggers>
                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" Duration="0:0:1.1">
                                                            <DiscreteDoubleKeyFrame Value="1" KeyTime="0:0:0"/>
                                                            <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0.55"/>
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="Placeholder" FontSize="22" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="KeysHost">
                    <Border x:Name="KeyHighlight" CornerRadius="14" Background="{DynamicResource Accent}">
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                    </Border>
                    <StackPanel>
                    <UniformGrid x:Name="Keys" Columns="10"/>
                    <Grid x:Name="Specials">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ShiftButton" Style="{StaticResource FnKey}" Click="Shift_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE752;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ShiftText" Text="Maj" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource FnKey}" Click="Space_Click">
                            <Border Width="120" Height="4" CornerRadius="2" Background="#55FFFFFF"/>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource FnKey}" Click="Backspace_Click">
                            <TextBlock Text="&#xE750;" FontFamily="{StaticResource Icons}" FontSize="20"/>
                        </Button>
                        <Button x:Name="ExtraButton" Grid.Column="3" Style="{StaticResource FnKey}" Content="Effacer" Click="Clear_Click"/>
                        <Button Grid.Column="4" Style="{StaticResource OkKey}" Click="Ok_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Valider" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</v:OverlayBase>
