<v:OverlayBase x:Class="MaRogAlly.Views.KeyboardPanel"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <v:OverlayBase.Resources>
        <!-- Touche : relief discret ; le contour de sélection glisse par-dessus les touches -->
        <Style x:Key="Key" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="82"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Tag">
                <Setter.Value>
                    <CornerRadius>14</CornerRadius>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Relief : un liseré clair en haut, plus sombre en bas -->
                            <Border x:Name="Bd" CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderThickness="0,1,0,3">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#26FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                        <GradientStop Color="#40000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                            </Trigger>
                            <!-- Sélectionnée à la manette : le fond laisse voir le cadre d'accent -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                                    <Condition Binding="{Binding PadSelection, RelativeSource={RelativeSource AncestorType=v:KeyboardPanel}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Touches de fonction : un peu plus sombres que les lettres -->
        <Style x:Key="FnKey" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        </Style>
        <!-- Valider : toujours à la couleur d'accent -->
        <Style x:Key="OkKey" TargetType="Button" BasedOn="{StaticResource Key}">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
    </v:OverlayBase.Resources>

    <Grid>
        <!-- Voile : léger en haut, plus dense vers le clavier. Il arrête les clics destinés à l'interface dessous et referme le clavier. -->
        <Rectangle x:Name="Backdrop" MouseLeftButtonUp="Backdrop_Click">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#66000000" Offset="0"/>
                    <GradientStop Color="#D9000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Clavier collé aux bords de l'écran (bas, gauche, droite), par-dessus la barre de gauche : les aides de la manette passent en haut -->
        <!-- L'ombre est portée par un fond à part : les touches ne repassent plus dans le flou à chaque image -->
        <Grid x:Name="Sheet" VerticalAlignment="Bottom">
        <Border CornerRadius="28,28,0,0" Background="{DynamicResource PanelBg}" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="Black"/>
            </Border.Effect>
        </Border>
        <Border x:Name="Panel" HorizontalAlignment="Stretch"
                CornerRadius="28,28,0,0" Background="Transparent" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"
                Padding="16,20,16,14" ClipToBounds="False">
            <Grid>
                <!-- Lueur d'accent derrière le champ de saisie -->
                <Ellipse Height="160" Width="700" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,-110,0,0" IsHitTestVisible="False" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/>
                            <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Grid x:Name="KeysHost">
                    <StackPanel>
                        <!-- Champ de saisie, avec à sa droite la remise à zéro -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Margin="3,0" CornerRadius="28" Background="#1AFFFFFF" BorderBrush="{DynamicResource Accent}" BorderThickness="2" Padding="26,0" Height="56">
                                <Grid VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="ValueText" FontFamily="{DynamicResource Display}" FontSize="26" Foreground="{StaticResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <!-- Curseur qui clignote -->
                                        <Border x:Name="Caret" Width="2" Height="28" Margin="3,0,0,0" Background="{DynamicResource Accent}" VerticalAlignment="Center">
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever" Duration="0:0:1.1">
                                                                <DiscreteDoubleKeyFrame Value="1" KeyTime="0:0:0"/>
                                                                <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0.55"/>
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="Placeholder" FontSize="22" Foreground="{StaticResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <!-- Dictée en cours -->
                                    <TextBlock x:Name="ListeningText" Text="Je t'écoute…" FontSize="18" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource FnKey}" Width="56" Height="56" Margin="3,0" ToolTip="Tout effacer" Click="Clear_Click">
                                <Button.Tag>
                                    <CornerRadius>28</CornerRadius>
                                </Button.Tag>
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="20"/>
                            </Button>
                        </Grid>

                        <!-- Rangées décalées d'un clavier classique. Une touche de lettre fait 2 colonnes : la deuxième rangée part d'une demi-touche, la troisième d'une touche. -->
                        <Grid x:Name="Keys">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="88"/>
                                <RowDefinition Height="88"/>
                                <RowDefinition Height="88"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="BackspaceButton" Grid.Column="20" Grid.ColumnSpan="4" Style="{StaticResource FnKey}" ToolTip="Effacer" Click="Backspace_Click">
                                <TextBlock Text="&#xE750;" FontFamily="{StaticResource Icons}" FontSize="24"/>
                            </Button>
                            <Button x:Name="EnterButton" Grid.Row="1" Grid.Column="21" Grid.ColumnSpan="3" Style="{StaticResource OkKey}" ToolTip="Entrer" Click="Ok_Click">
                                <TextBlock Text="&#xE751;" FontFamily="{StaticResource Icons}" FontSize="26"/>
                            </Button>
                            <Button x:Name="ShiftButton" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource FnKey}" Click="Shift_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE752;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ShiftText" Text="Maj" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ShiftRightButton" Grid.Row="2" Grid.Column="22" Grid.ColumnSpan="2" Style="{StaticResource FnKey}" Click="Shift_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE752;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ShiftRightText" Text="Maj" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Dernière rangée : caractères spéciaux, dictée, espace et chiffres -->
                        <Grid x:Name="Specials">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="4.5*"/>
                                <ColumnDefinition Width="5.5*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Caractères spéciaux : la même touche ramène aux lettres -->
                            <Button x:Name="SymbolsButton" Style="{StaticResource FnKey}" Content="@" Click="Symbols_Click"/>
                            <!-- Dictée (remplacée par « Coller » pour les clés d'API) -->
                            <Button x:Name="VoiceButton" Grid.Column="1" Style="{StaticResource FnKey}" ToolTip="Dicter">
                                <TextBlock x:Name="VoiceIcon" Text="&#xE720;" FontFamily="{StaticResource Icons}" FontSize="22"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource FnKey}" Click="Space_Click">
                                <Border Width="120" Height="4" CornerRadius="2" Background="#55FFFFFF"/>
                            </Button>
                            <UniformGrid x:Name="Digits" Grid.Column="3" Rows="1"/>
                        </Grid>
                    </StackPanel>
                    <!-- Sélection à la manette : un simple contour à la couleur d'accent, comme dans le reste de l'application, posé sur la touche -->
                    <Border x:Name="KeyHighlight" CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="2"/>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</v:OverlayBase>
