<v:OverlayBase x:Class="MaRogAlly.Views.StorePrompt"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <!-- Voile sombre sur toute l'application : le reste n'est plus cliquable tant que l'écran est affiché -->
    <Grid Background="#E6050608">
        <StackPanel x:Name="Body" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
            <Path x:Name="PlatformLogo" Width="46" Height="46" Stretch="Uniform" Fill="White" HorizontalAlignment="Center">
                <Path.Effect>
                    <DropShadowEffect x:Name="LogoGlow" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
                </Path.Effect>
            </Path>
            <TextBlock x:Name="GameTitle" Style="{StaticResource H1}" FontSize="34" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" Margin="0,20,0,0"/>

            <!-- Étape 1 : confirmation -->
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                <Button x:Name="OpenButton" Style="{StaticResource PillButton}" Click="Open_Click" Background="{DynamicResource Accent}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="OpenText" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Facultatif : autre site (ex. recherche Instant Gaming) -->
                <Button x:Name="AltButton" Style="{StaticResource PillButton}" Click="Alt_Click" Visibility="Collapsed" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock x:Name="AltText" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Étape 2 : ouverture en cours -->
            <StackPanel x:Name="Opening" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0" Visibility="Collapsed">
                <Grid Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Center">
                    <Ellipse Stroke="#26FFFFFF" StrokeThickness="3"/>
                    <!-- Arc tournant -->
                    <Path Stroke="{DynamicResource Accent}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 13,1.5 A 11.5,11.5 0 0 1 24.5,13" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="Spin"/>
                        </Path.RenderTransform>
                    </Path>
                </Grid>
                <TextBlock x:Name="OpeningText" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</v:OverlayBase>
