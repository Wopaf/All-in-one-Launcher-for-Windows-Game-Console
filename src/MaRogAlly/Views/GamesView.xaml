<UserControl x:Class="MaRogAlly.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MaRogAlly.UI"
             xmlns:m="clr-namespace:MaRogAlly.Models"
             xmlns:v="clr-namespace:MaRogAlly.Views"
             Focusable="False">

    <UserControl.Resources>

        <!-- ====== Vignette de jeu ====== -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type m:Game}">
            <Grid Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Height="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  Margin="{Binding TileMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  RenderTransformOrigin="0.5,0.5" Cursor="Hand" Background="Transparent"
                  MouseLeftButtonUp="Tile_Click">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="Scale"/>
                </Grid.RenderTransform>

                <!-- Halo de sélection -->
                <Border x:Name="Glow" CornerRadius="14" Background="{DynamicResource Accent}" Margin="-6" Opacity="0" Visibility="Hidden">
                    <Border.Effect>
                        <BlurEffect Radius="22" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>

                <Grid x:Name="Card" ui:Rounded.Radius="10" Background="#1A1F2A">
                    <!-- Repli quand il n'y a pas encore de jaquette -->
                    <Grid Visibility="{Binding CoverPath, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#262C3A" Offset="0"/>
                                <GradientStop Color="#12151C" Offset="1"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <TextBlock Text="{Binding DisplayTitle}" Margin="14" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                                   FontSize="17" Foreground="{StaticResource TextSecondary}" TextTrimming="WordEllipsis"/>
                    </Grid>

                    <Image ui:ImageLoader.DecodeWidth="320" ui:ImageLoader.Source="{Binding CoverPath}"
                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>


                    <!-- Plateforme (visible à la sélection) -->
                    <Border x:Name="Tag" VerticalAlignment="Bottom" Opacity="0" Padding="12,34,12,11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000A0C11" Offset="0"/>
                                <GradientStop Color="#F20A0C11" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{Binding PlatformInfo.Logo}" Fill="White" Stretch="Uniform" Width="18" Height="18"
                                  Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PlatformInfo.Name}" FontFamily="{StaticResource Display}" FontWeight="SemiBold"
                                       FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="Frame" CornerRadius="10" BorderThickness="3" BorderBrush="White" Opacity="0" Margin="-1"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.28">
                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.28">
                                    <DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.25"/>
                                <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                <DoubleAnimation Storyboard.TargetName="Tag" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="Tag" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Emplacement vide de la dernière rangée : carte fantôme discrète, non sélectionnable -->
        <DataTemplate x:Key="ShadowTemplate">
            <Border Width="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Margin="{Binding TileMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CornerRadius="10" Background="#07FFFFFF" BorderBrush="#0FFFFFFF" BorderThickness="1" IsHitTestVisible="False"/>
        </DataTemplate>

        <v:TileSelector x:Key="TileSelector" Tile="{StaticResource TileTemplate}" Shadow="{StaticResource ShadowTemplate}"/>

        <!-- Bouton de catégorie au-dessus de la Bibliothèque -->
        <Style x:Key="CategoryChip" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#16FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="17" Height="34" Padding="16,0" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Une rangée de vignettes -->
        <DataTemplate x:Key="RowTemplate">
            <ItemsControl ItemsSource="{Binding}" ItemTemplateSelector="{StaticResource TileSelector}" Focusable="False"
                          Height="{Binding RowHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                          Padding="{Binding RowPadding, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- Badge d'information (note, année, genres, studio, temps de jeu) -->
        <Style x:Key="MetaBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="BorderBrush" Value="#14FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MetaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <!-- Fiche, barre d'outils et rangée forment un bloc centré verticalement -->
    <Grid VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== Fiche du jeu sélectionné ====== -->
        <StackPanel x:Name="DetailPanel" Margin="64,0,64,22" ClipToBounds="False" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="900">
            <Grid x:Name="LogoBox" Height="150" HorizontalAlignment="Left" MaxWidth="640">
                <Image ui:ImageLoader.Source="{Binding LogoPath}" ui:ImageLoader.DecodeWidth="900"
                       Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
                    </Image.Effect>
                </Image>
                <TextBlock x:Name="TitleText" Text="{Binding DisplayTitle}" Style="{StaticResource H1}" TextWrapping="Wrap" MaxWidth="820"
                           VerticalAlignment="Bottom" LineStackingStrategy="BlockLineHeight" LineHeight="50"
                           Visibility="{Binding LogoPath, Converter={StaticResource VisibleIf}, ConverterParameter=invert}"/>
            </Grid>

            <!-- Une seule ligne de badges : la hauteur de la fiche reste fixe, la rangée ne bouge pas -->
            <StackPanel x:Name="MetaRow" Orientation="Horizontal" Margin="0,16,0,0" Height="30" ClipToBounds="True">
                <Border Style="{StaticResource MetaBadge}" BorderThickness="0"
                        Background="{Binding PlatformInfo.Color, Converter={StaticResource ColorBrush}, ConverterParameter=0.22}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{Binding PlatformInfo.Logo}" Fill="White" Stretch="Uniform" Width="15" Height="15"
                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PlatformInfo.Name}" Style="{StaticResource MetaText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetaBadge}" Visibility="{Binding Rating, Converter={StaticResource VisibleIf}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Gold}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding RatingText}" Style="{StaticResource MetaText}" FontWeight="Bold"/>
                        <TextBlock Text="/100" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="2,1,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetaBadge}" Visibility="{Binding ReleaseYear, Converter={StaticResource VisibleIf}}">
                    <TextBlock Style="{StaticResource MetaText}" Text="{Binding ReleaseYear}"/>
                </Border>
                <Border Style="{StaticResource MetaBadge}" Visibility="{Binding GenresText, Converter={StaticResource VisibleIf}}">
                    <TextBlock Style="{StaticResource MetaText}" Text="{Binding GenresText}"/>
                </Border>
                <Border Style="{StaticResource MetaBadge}" Visibility="{Binding PlaytimeText, Converter={StaticResource VisibleIf}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Style="{StaticResource MetaText}" Text="{Binding PlaytimeText}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock x:Name="DescText" Text="{Binding Description}" Style="{StaticResource BodyText}" Margin="0,14,0,0" MaxWidth="780"
                       HorizontalAlignment="Left" VerticalAlignment="Top" MaxHeight="72" TextTrimming="WordEllipsis"/>
        </StackPanel>

        <!-- ====== Catégories (Bibliothèque) : le cadre de sélection glisse d'un bouton à l'autre ====== -->
        <Grid Grid.Row="1" Margin="64,0,64,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PadGlyph}" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="PrevCategory_Click"
                    Visibility="{Binding Visibility, ElementName=CategoryHost}">
                <TextBlock Text="LT" Style="{StaticResource PadGlyphText}"/>
            </Border>
            <ScrollViewer Grid.Column="1" Style="{StaticResource RowScroll}" Margin="0">
                <Grid x:Name="CategoryHost" HorizontalAlignment="Left" Visibility="Collapsed">
                    <StackPanel x:Name="CategoryBar" Orientation="Horizontal"/>
                    <Border x:Name="CategoryHighlight" CornerRadius="17" BorderBrush="White" BorderThickness="2"/>
                </Grid>
            </ScrollViewer>
            <Border Grid.Column="2" Style="{StaticResource PadGlyph}" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="NextCategory_Click"
                    Visibility="{Binding Visibility, ElementName=CategoryHost}">
                <TextBlock Text="RT" Style="{StaticResource PadGlyphText}"/>
            </Border>
        </Grid>

        <!-- ====== Grille (rangées virtualisées) ====== -->
        <Grid Grid.Row="2" x:Name="GridHost" Margin="0,14,0,0">
            <ItemsControl x:Name="RowsList" Focusable="False" ItemTemplate="{StaticResource RowTemplate}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="2,2"
                          VirtualizingPanel.CacheLengthUnit="Item" ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="Scroller" Focusable="False" CanContentScroll="True" PanningMode="VerticalOnly"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                            <!-- La marge agrandit la zone visible autour des rangées : le halo de la sélection n'y est pas coupé -->
                            <ItemsPresenter Margin="{TemplateBinding Padding}"/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>


            <!-- Indicateur de rangées : petits points, point allongé pour la rangée visible -->
            <StackPanel x:Name="Dots" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0" Width="8" IsHitTestVisible="False"/>

            <!-- Aucun résultat -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Icons}" FontSize="44" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" Margin="0,16,0,6" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyHint" Style="{StaticResource BodyText}" TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

    </Grid>
</UserControl>
