<UserControl x:Class="MaRogAlly.Views.ExploreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MaRogAlly.UI"
             xmlns:s="clr-namespace:MaRogAlly.Services"
             xmlns:v="clr-namespace:MaRogAlly.Views"
             Focusable="False">
    <UserControl.Resources>

        <!-- Bandeau À la une : comme une jaquette (halo et contour à la sélection), sans zoom, qui le ferait sortir de l'écran -->
        <Style x:Key="BannerCard" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow" CornerRadius="16" Background="{DynamicResource Accent}" Margin="-6" Opacity="0" Visibility="Hidden">
                                <Border.Effect>
                                    <BlurEffect Radius="22" RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <Grid ui:Rounded.Radius="14" Background="#1A1F2A">
                                <ContentPresenter/>
                            </Grid>
                            <Border x:Name="Frame" CornerRadius="14" BorderThickness="3" BorderBrush="{DynamicResource Accent}" Opacity="0" Margin="-1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Glow" Property="Visibility" Value="Visible"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barre de recherche : un grand bouton qui ouvre le clavier -->
        <Style x:Key="SearchBar" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0,10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Rayons calculés sur la hauteur de chaque couche : fond et cadre gardent le même arrondi -->
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"/>
                            <Border x:Name="Frame" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderBrush="{DynamicResource Accent}" BorderThickness="3" Opacity="0" Margin="-1"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2BFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Résultat : jaquette, plateforme en bas, prix ou « Possédé » en haut -->
        <DataTemplate x:Key="HitCard" DataType="{x:Type s:SearchHit}">
            <Button Style="{StaticResource MediaCard}" Tag="8" Margin="0,0,18,0" Click="Hit_Click" GotKeyboardFocus="Hit_Focus"
                    Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <TextBlock Text="{Binding Title}" Margin="10" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="14" Foreground="{StaticResource TextSecondary}" TextTrimming="WordEllipsis"/>
                    <Image ui:ImageLoader.Source="{Binding CoverPath}" ui:ImageLoader.DecodeWidth="300" Stretch="UniformToFill"/>
                    <Border x:Name="PriceBadge" CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#E60A0C11" Visibility="{Binding Badge, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding Badge}" FontFamily="{DynamicResource Display}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Border>
                    <!-- Dans la liste de souhaits -->
                    <Border CornerRadius="11" Width="22" Height="22" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E60A0C11"
                            Visibility="{Binding IsWished, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FF5C8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border VerticalAlignment="Bottom" Padding="10,26,10,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000A0C11" Offset="0"/>
                                <GradientStop Color="#E60A0C11" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{Binding Platform.Logo}" Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Platform.Name}" FontFamily="{DynamicResource Display}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="{StaticResource FreeGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="#2D7FF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Jeu offert par Epic : visuel large, titre et compte à rebours ; badge GRATUIT, BIENTÔT ou OBTENU -->
        <DataTemplate x:Key="FreeCard" DataType="{x:Type s:FreeGame}">
            <Button Style="{StaticResource MediaCard}" Tag="10" Margin="0,0,18,0" Click="Free_Click" GotKeyboardFocus="Free_Focus"
                    Width="{Binding FreeCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding FreeHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <TextBlock Text="{Binding Title}" Margin="12" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="15" Foreground="{StaticResource TextSecondary}"/>
                    <Image ui:ImageLoader.Source="{Binding ImagePath}" ui:ImageLoader.DecodeWidth="560" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom" Padding="12,22,12,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000A0C11" Offset="0"/>
                                <GradientStop Color="#F00A0C11" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontFamily="{DynamicResource Display}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Countdown}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Badge" CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource FreeGreen}">
                        <TextBlock Text="{Binding Badge}" FontFamily="{DynamicResource Display}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="False">
                    <Setter TargetName="Badge" Property="Background" Value="#CC2D3448"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="#2D7FF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Jeu de la rangée En tendance : jaquette, prix (ou date de sortie) ou « Possédé » -->
        <DataTemplate x:Key="NewCard" DataType="{x:Type s:DiscoverGame}">
            <Button Style="{StaticResource MediaCard}" Tag="8" Margin="0,0,18,0" Click="New_Click" GotKeyboardFocus="New_Focus"
                    Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <TextBlock Text="{Binding Name}" Margin="10" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="14" Foreground="{StaticResource TextSecondary}" TextTrimming="WordEllipsis"/>
                    <!-- Sans jaquette verticale : l'image horizontale entière, sur un fond flouté tiré d'elle-même -->
                    <Image x:Name="CoverBlur" ui:ImageLoader.Source="{Binding CoverPath}" ui:ImageLoader.DecodeWidth="300" Stretch="UniformToFill" Opacity="0.5" Visibility="Collapsed">
                        <Image.Effect><BlurEffect Radius="22" KernelType="Gaussian"/></Image.Effect>
                    </Image>
                    <Image x:Name="Cover" ui:ImageLoader.Source="{Binding CoverPath}" ui:ImageLoader.DecodeWidth="300" Stretch="UniformToFill"/>
                    <!-- Dans la liste de souhaits -->
                    <Border CornerRadius="11" Width="22" Height="22" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E60A0C11"
                            Visibility="{Binding IsWished, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FF5C8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="PriceBadge" CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="#E60A0C11" Visibility="{Binding CardBadge, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding CardBadge}" FontFamily="{DynamicResource Display}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CoverWide}" Value="True">
                    <Setter TargetName="CoverBlur" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Cover" Property="Stretch" Value="Uniform"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="{StaticResource FreeGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="#2D7FF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Rangée d'une liste (les plus attendus, les plus joués, en promotion) : titre, sous-titre à droite, jaquettes -->
        <DataTemplate x:Key="TrendRowTemplate" DataType="{x:Type v:TrendRow}">
            <StackPanel Margin="0,28,0,0">
                <Grid Margin="64,0,64,14">
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextMuted}"/>
                </Grid>
                <ScrollViewer Style="{StaticResource RowScroll}" Margin="0,-26,-24,-26" ui:EdgeFade.Size="64">
                    <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource NewCard}" Focusable="False" Margin="64,26,26,26"
                                  RequestBringIntoView="Row_RequestBringIntoView">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Page qui défile : recherche, à la une, les jeux offerts par Epic, la rangée En tendance (ou les résultats d'une recherche),
         puis une rangée par liste (liste de souhaits comprise). La page suit la sélection (voir ScrollPage). -->
    <ScrollViewer x:Name="PageScroll" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
        <StackPanel x:Name="PageContent" Margin="0,14,0,48">
        <!-- ====== Recherche ====== -->
        <Grid x:Name="SearchRow" Margin="64,0,64,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SearchButton" Style="{StaticResource SearchBar}" Height="60"
                    Click="Search_Click" GotKeyboardFocus="Search_Focus">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="QueryText" Grid.Column="1" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{x:Static v:ExploreView.SteamLogo}" Fill="#99FFFFFF" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"/>
                        <Path Data="{x:Static v:ExploreView.GogLogo}" Fill="#99FFFFFF" Stretch="Uniform" Width="18" Height="18" Margin="0,0,14,0"/>
                    </StackPanel>
                </Grid>
            </Button>
            <!-- Efface la recherche (inactif tant qu'il n'y en a pas) -->
            <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource SearchBar}" Margin="12,0,0,0" Padding="0" IsEnabled="False"
                    Width="{Binding ActualHeight, ElementName=SearchButton}" Height="{Binding ActualHeight, ElementName=SearchButton}"
                    HorizontalContentAlignment="Center" ToolTip="Effacer la recherche" Click="Reset_Click" GotKeyboardFocus="Reset_Focus">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource TextPrimary}"/>
            </Button>
        </Grid>

        <!-- ====== À la une : les jeux du moment, l'un après l'autre (←→ quand il est sélectionné) ====== -->
        <Button x:Name="Spotlight" Style="{StaticResource BannerCard}" Margin="64,0,64,0" Height="220" Visibility="Collapsed"
                Click="Spotlight_Click" GotKeyboardFocus="Spotlight_Focus" LostKeyboardFocus="Spotlight_Blur">
            <Grid>
                <Grid x:Name="SpotlightBody">
                    <Image ui:ImageLoader.Source="{Binding HeroPath}" ui:ImageLoader.DecodeWidth="1600" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#F20A0C11" Offset="0"/>
                                <GradientStop Color="#A60A0C11" Offset="0.5"/>
                                <GradientStop Color="#1A0A0C11" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel x:Name="SpotlightText" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="36,0,36,0" MaxWidth="820">
                        <TextBlock Text="À LA UNE" Style="{StaticResource Label}" Foreground="{DynamicResource Accent}"/>
                        <TextBlock x:Name="SpotlightTitle" Text="{Binding Name}" FontFamily="{DynamicResource Display}" FontWeight="Bold" FontSize="36"
                                   Foreground="White" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding Spotlight}" FontSize="15" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <ItemsControl ItemsSource="{Binding Platforms}" Focusable="False" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="9,3" Margin="0,0,6,0" Background="#33FFFFFF">
                                        <TextBlock Text="{Binding}" FontFamily="{DynamicResource Display}" FontWeight="SemiBold" FontSize="12" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="SpotlightDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,18"/>
            </Grid>
        </Button>

        <!-- ====== Jeux offerts par Epic (masqués pendant une recherche) ====== -->
        <StackPanel x:Name="FreeSection" Margin="0,28,0,0" Visibility="Collapsed">
            <TextBlock Text="OFFERTS PAR EPIC GAMES" Style="{StaticResource Label}" Margin="64,0,0,14"/>
            <ScrollViewer Style="{StaticResource RowScroll}" Margin="0,-26,-24,-26" ui:EdgeFade.Size="64">
                <StackPanel Orientation="Horizontal" Margin="64,26,26,26">
                    <ItemsControl x:Name="FreeGames" ItemTemplate="{StaticResource FreeCard}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <!-- Places vides jusqu'à 4 cartes : la rangée garde sa forme même avec une ou deux offres -->
                    <ItemsControl x:Name="FreeShadows" Focusable="False" IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Margin="0,0,18,0" Background="#0DFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1"
                                        Width="{Binding FreeCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Height="{Binding FreeHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="#26FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>



        <StackPanel x:Name="MainArea" Margin="0,24,0,0">
            <!-- ====== En tendance, ou résultats de la recherche ====== -->
            <Grid x:Name="ResultsArea">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="34"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ResultsLabel" Style="{StaticResource Label}" Text="RÉSULTATS" VerticalAlignment="Center" Margin="64,0,0,14"/>

                <ScrollViewer x:Name="HitsScroll" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowScroll}" Margin="0,-26,-24,-26" ui:EdgeFade.Size="64">
                    <ItemsControl x:Name="Hits" ItemTemplate="{StaticResource HitCard}" Focusable="False" Margin="64,26,26,26">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="NewScroll" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowScroll}" Margin="0,-26,-24,-26" ui:EdgeFade.Size="64">
                    <ItemsControl x:Name="NewGames" ItemTemplate="{StaticResource NewCard}" Focusable="False" Margin="64,26,26,26">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Aucun résultat / recherche en cours / chargement -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" Grid.ColumnSpan="2" Margin="64,0,64,0" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" FontSize="22"/>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource BodyText}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Jeu sélectionné ou décompte : sur la ligne du titre pour les nouveautés, sous la liste pendant une recherche (voir PlaceInfo).
                     Une place fixe : la rangée de jaquettes ne bouge jamais. -->
                <Grid x:Name="InfoLine" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultsCount" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HitInfo" VerticalAlignment="Center" FontSize="13"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed">
                        <Run x:Name="HitTitle" FontFamily="{DynamicResource Display}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimary}"/><Run x:Name="HitDetail" Foreground="{StaticResource TextSecondary}"/>
                    </TextBlock>
                </Grid>
            </Grid>

            <!-- ====== Les autres listes, une rangée chacune (masquées pendant une recherche) ====== -->
            <ItemsControl x:Name="MoreRows" ItemTemplate="{StaticResource TrendRowTemplate}" Focusable="False"/>

        </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
