<UserControl x:Class="MaRogAlly.Views.ExploreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MaRogAlly.UI"
             xmlns:s="clr-namespace:MaRogAlly.Services"
             xmlns:v="clr-namespace:MaRogAlly.Views"
             Focusable="False">
    <UserControl.Resources>

        <!-- Barre de recherche : un grand bouton qui ouvre le clavier -->
        <Style x:Key="SearchBar" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="24,0,10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Rayons calculés sur la hauteur de chaque couche : fond et cadre gardent le même arrondi -->
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Bd" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1"/>
                            <Border x:Name="Frame" CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource PillRadius}}" BorderBrush="White" BorderThickness="3" Opacity="0" Margin="-1"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2BFFFFFF"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Résultat : jaquette, plateforme en bas, prix ou « Possédé » en haut -->
        <DataTemplate x:Key="HitCard" DataType="{x:Type s:SearchHit}">
            <Button Style="{StaticResource MediaCard}" Tag="8" Margin="0,0,18,0" Click="Hit_Click" GotKeyboardFocus="Hit_Focus"
                    Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <TextBlock Text="{Binding Title}" Margin="10" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="14" Foreground="{StaticResource TextSecondary}" TextTrimming="WordEllipsis"/>
                    <Image ui:ImageLoader.Source="{Binding CoverPath}" ui:ImageLoader.DecodeWidth="300" Stretch="UniformToFill"/>
                    <Border x:Name="PriceBadge" CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#E60A0C11" Visibility="{Binding Badge, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Border>
                    <!-- Dans la liste de souhaits -->
                    <Border CornerRadius="11" Width="22" Height="22" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E60A0C11"
                            Visibility="{Binding IsWished, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FF5C8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border VerticalAlignment="Bottom" Padding="10,26,10,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000A0C11" Offset="0"/>
                                <GradientStop Color="#E60A0C11" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{Binding Platform.Logo}" Fill="White" Stretch="Uniform" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Platform.Name}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="{StaticResource FreeGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="#2D7FF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Jeu offert par Epic : visuel large, titre et compte à rebours ; badge GRATUIT, BIENTÔT ou OBTENU -->
        <DataTemplate x:Key="FreeCard" DataType="{x:Type s:FreeGame}">
            <Button Style="{StaticResource MediaCard}" Tag="10" Margin="6" Click="Free_Click" GotKeyboardFocus="Free_Focus"
                    Width="{Binding FreeCardWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding FreeHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <TextBlock Text="{Binding Title}" Margin="12" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="15" Foreground="{StaticResource TextSecondary}"/>
                    <Image ui:ImageLoader.Source="{Binding ImagePath}" ui:ImageLoader.DecodeWidth="560" Stretch="UniformToFill"/>
                    <Border VerticalAlignment="Bottom" Padding="12,22,12,9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000A0C11" Offset="0"/>
                                <GradientStop Color="#F00A0C11" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" MaxHeight="38" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Countdown}" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="Badge" CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{StaticResource FreeGreen}">
                        <TextBlock Text="{Binding Badge}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="11" Foreground="White"/>
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="False">
                    <Setter TargetName="Badge" Property="Background" Value="#CC2D3448"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="#2D7FF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Jeu de la section Nouveautés : jaquette, prix ou « Possédé » -->
        <DataTemplate x:Key="NewCard" DataType="{x:Type s:DiscoverGame}">
            <Button Style="{StaticResource MediaCard}" Tag="8" Margin="0,0,18,0" Click="New_Click" GotKeyboardFocus="New_Focus"
                    Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <TextBlock Text="{Binding Name}" Margin="10" TextWrapping="Wrap" VerticalAlignment="Center" TextAlignment="Center"
                               FontSize="14" Foreground="{StaticResource TextSecondary}" TextTrimming="WordEllipsis"/>
                    <Image ui:ImageLoader.Source="{Binding CoverPath}" ui:ImageLoader.DecodeWidth="300" Stretch="UniformToFill"/>
                    <!-- Dans la liste de souhaits -->
                    <Border CornerRadius="11" Width="22" Height="22" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E60A0C11"
                            Visibility="{Binding IsWished, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="&#xEB52;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="#FF5C8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="PriceBadge" CornerRadius="6" Padding="7,2" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="#E60A0C11" Visibility="{Binding CardBadge, Converter={StaticResource VisibleIf}}">
                        <TextBlock Text="{Binding CardBadge}" FontFamily="{StaticResource Display}" FontWeight="Bold" FontSize="12" Foreground="White"/>
                    </Border>
                </Grid>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDiscounted}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="{StaticResource FreeGreen}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOwned}" Value="True">
                    <Setter TargetName="PriceBadge" Property="Background" Value="#2D7FF9"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Tuile d'une liste de tendances Steam (ouvre la page des tendances) ; les tuiles se partagent toute la largeur -->
        <DataTemplate x:Key="TrendTile" DataType="{x:Type v:DiscoverTile}">
            <Button Style="{StaticResource MediaCard}" Tag="10" Margin="0,0,18,0" Click="Tile_Click" GotKeyboardFocus="Tile_Focus"
                    Height="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Grid>
                    <Rectangle Fill="{Binding Tint}" Opacity="0.28"/>
                    <Image ui:ImageLoader.Source="{Binding Lead.HeroPath}" ui:ImageLoader.DecodeWidth="640" Stretch="UniformToFill"/>
                    <Rectangle Fill="#990A0C11"/>
                    <TextBlock Text="{Binding Title}" Margin="14,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource Display}" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"
                               FontSize="{Binding TileTitleSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <!-- De haut en bas : recherche, accès aux listes, puis les jeux à voir (nouveautés à gauche, offres Epic à droite) -->
    <Grid x:Name="Root" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====== Recherche ====== -->
        <Grid Margin="64,0,64,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SearchButton" Style="{StaticResource SearchBar}" Height="60"
                    Click="Search_Click" GotKeyboardFocus="Search_Focus">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="20" VerticalAlignment="Center" Margin="0,0,16,0"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="QueryText" Grid.Column="1" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextMuted}"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{x:Static v:ExploreView.SteamLogo}" Fill="#99FFFFFF" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"/>
                        <Path Data="{x:Static v:ExploreView.GogLogo}" Fill="#99FFFFFF" Stretch="Uniform" Width="18" Height="18" Margin="0,0,14,0"/>
                    </StackPanel>
                </Grid>
            </Button>
            <!-- Efface la recherche (inactif tant qu'il n'y en a pas) -->
            <Button x:Name="ResetButton" Grid.Column="1" Style="{StaticResource SearchBar}" Margin="12,0,0,0" Padding="0" IsEnabled="False"
                    Width="{Binding ActualHeight, ElementName=SearchButton}" Height="{Binding ActualHeight, ElementName=SearchButton}"
                    HorizontalContentAlignment="Center" ToolTip="Effacer la recherche" Click="Reset_Click" GotKeyboardFocus="Reset_Focus">
                <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="17" Foreground="{StaticResource TextPrimary}"/>
            </Button>
        </Grid>

        <!-- ====== Accès aux listes ====== -->
        <!-- Marge droite réduite de l'écart entre tuiles : la dernière s'aligne sur le bord -->
        <!-- Sans arrondi de la mise en page : des colonnes à largeur fractionnaire feraient couper le cadre de la sélection à la rangée -->
        <ItemsControl x:Name="Tiles" Grid.Row="1" ItemTemplate="{StaticResource TrendTile}" Focusable="False" Margin="64,14,46,0" UseLayoutRounding="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <Grid x:Name="MainArea" Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ====== Nouveautés, ou résultats de la recherche ====== -->
            <Grid x:Name="ResultsArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Le jeu sélectionné s'affiche sur la ligne du titre : la rangée de jaquettes ne bouge jamais -->
                <Grid Margin="64,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultsLabel" Style="{StaticResource Label}" Text="RÉSULTATS" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultsCount" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="HitInfo" Grid.Column="1" Margin="24,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed">
                        <Run x:Name="HitTitle" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextPrimary}"/><Run x:Name="HitDetail" Foreground="{StaticResource TextSecondary}"/>
                    </TextBlock>
                </Grid>

                <ScrollViewer x:Name="HitsScroll" Grid.Row="1" Style="{StaticResource RowScroll}" Margin="0,-26,-24,-26">
                    <ItemsControl x:Name="Hits" ItemTemplate="{StaticResource HitCard}" Focusable="False" Margin="64,26,26,26">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer x:Name="NewScroll" Grid.Row="1" Style="{StaticResource RowScroll}" Margin="0,-26,-24,-26">
                    <ItemsControl x:Name="NewGames" ItemTemplate="{StaticResource NewCard}" Focusable="False" Margin="64,26,26,26">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Aucun résultat / recherche en cours / chargement -->
                <StackPanel x:Name="EmptyState" Grid.Row="1" Margin="64,0,64,0" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyTitle" Style="{StaticResource H2}" FontSize="22"/>
                    <TextBlock x:Name="EmptyHint" Style="{StaticResource BodyText}" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>
                </StackPanel>
            </Grid>

            <!-- ====== Jeux offerts par Epic (masqués pendant une recherche, pour laisser la place aux résultats) ====== -->
            <StackPanel x:Name="FreeSection" Grid.Column="1" Margin="36,0,64,0" Visibility="Collapsed"
                        Width="{Binding FreeWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock Text="OFFERTS PAR EPIC GAMES" Style="{StaticResource Label}" Margin="0,0,0,12"/>
                <!-- Marges opposées : le halo de la sélection n'est pas coupé -->
                <ScrollViewer Margin="-26,-26,-26,-26" Focusable="False" PanningMode="VerticalOnly" Height="{Binding FreeScrollHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="FreeGames" ItemTemplate="{StaticResource FreeCard}" Focusable="False" Margin="20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
