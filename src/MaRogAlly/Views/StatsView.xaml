<v:OverlayBase x:Class="MaRogAlly.Views.StatsView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <Grid Background="{StaticResource Bg}">
        <!-- Lueur d'ambiance à la couleur d'accent -->
        <Ellipse Width="1400" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-600,-500,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Rectangle Fill="{StaticResource BackdropPattern}" IsHitTestVisible="False"/>

        <ScrollViewer x:Name="Scroll" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
            <StackPanel x:Name="Body" Margin="64,34,64,90" MaxWidth="1500"/>
        </ScrollViewer>
    </Grid>
</v:OverlayBase>
