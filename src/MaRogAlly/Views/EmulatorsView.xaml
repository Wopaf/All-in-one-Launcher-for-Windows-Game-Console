<UserControl x:Class="MaRogAlly.Views.EmulatorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:MaRogAlly.UI"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="44"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ====== Halo et filigrane à la couleur de la console ====== -->
        <Ellipse Width="1300" Height="1300" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-620,-420,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop x:Name="GlowStop" Color="#66D9333F" Offset="0"/>
                    <GradientStop x:Name="GlowEnd" Color="#00D9333F" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Path x:Name="Watermark" Width="680" Height="680" Stretch="Uniform" Fill="White" Opacity="0.035"
              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-80,40" IsHitTestVisible="False"
              RenderTransformOrigin="0.5,0.5">
            <Path.RenderTransform>
                <RotateTransform Angle="-12"/>
            </Path.RenderTransform>
        </Path>

        <Grid Margin="64,8,64,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="360"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== Liste des émulateurs ====== -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="18,0,0,18">
                    <TextBlock x:Name="ListTitle" Text="Émulateurs" Style="{StaticResource H1}" FontSize="34"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource BodyText}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <Grid x:Name="ListHost" Margin="0,0,0,60">
                        <Border x:Name="ListHighlight" CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="2"/>
                        <StackPanel x:Name="List"/>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- ====== Fiche de l'émulateur sélectionné ====== -->
            <ScrollViewer x:Name="ShowcaseScroll" Grid.Column="2" Margin="-48,0,0,0" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <StackPanel x:Name="Showcase" Margin="48,30,0,40">
                    <Path x:Name="BigLogo" Width="120" Height="72" Stretch="Uniform" Fill="White" HorizontalAlignment="Left">
                        <Path.Effect>
                            <DropShadowEffect x:Name="LogoGlow" BlurRadius="28" ShadowDepth="0" Opacity="0.9"/>
                        </Path.Effect>
                    </Path>

                    <TextBlock x:Name="NameText" Style="{StaticResource H1}" FontSize="50" Margin="0,18,0,0"/>
                    <TextBlock x:Name="EmulatorText" Style="{StaticResource BodyText}" FontSize="19" Margin="0,2,0,0" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock x:Name="PitchText" Style="{StaticResource BodyText}" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>

                    <Border x:Name="StatusChip" CornerRadius="15" Padding="12,6,14,6" Margin="0,16,0,0" HorizontalAlignment="Left" Background="#1FFFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Téléchargement en cours -->
                    <Grid x:Name="ProgressBar" Width="520" Height="4" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="Collapsed">
                        <Border CornerRadius="2" Background="#1FFFFFFF"/>
                        <Border x:Name="ProgressFill" CornerRadius="2" HorizontalAlignment="Left" Width="0" Background="{DynamicResource Accent}"/>
                    </Grid>

                    <!-- Actions : à la manette, droite depuis la liste, puis A -->
                    <WrapPanel x:Name="Actions" Margin="0,22,0,0" MaxWidth="900" HorizontalAlignment="Left"/>

                    <TextBlock x:Name="NoteText" Style="{StaticResource BodyText}" FontSize="14" Margin="0,14,0,0" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"/>

                    <!-- Jeux détectés -->
                    <TextBlock x:Name="GamesLabel" Style="{StaticResource Label}" Margin="0,26,0,10"/>
                    <ItemsControl x:Name="Covers" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="{Binding CoverWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Height="{Binding CoverHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,14,0" ui:Rounded.Radius="10" Background="#1A1F2A">
                                    <TextBlock Text="{Binding DisplayTitle}" Margin="10" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" TextTrimming="WordEllipsis"/>
                                    <Image ui:ImageLoader.DecodeWidth="240" ui:ImageLoader.Source="{Binding CoverPath}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoGamesText" Style="{StaticResource BodyText}" FontSize="15" TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left" Visibility="Collapsed"/>

                    <!-- Dossiers scannés -->
                    <TextBlock Text="DOSSIERS DE JEUX" Style="{StaticResource Label}" Margin="0,26,0,10"/>
                    <StackPanel x:Name="Folders"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
