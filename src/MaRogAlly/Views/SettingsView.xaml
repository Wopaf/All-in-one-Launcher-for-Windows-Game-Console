<UserControl x:Class="MaRogAlly.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid Margin="64,8,64,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MenuColumn" Width="300"/>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*" MaxWidth="700"/>
            <ColumnDefinition Width="40"/>
            <ColumnDefinition x:Name="HelpColumn" Width="*" MaxWidth="420"/>
        </Grid.ColumnDefinitions>

        <!-- ====== Catégories (même présentation que la liste des plateformes) ====== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="18,0,0,18">
                <TextBlock x:Name="MenuTitle" Text="Réglages" Style="{StaticResource H1}" FontSize="34"/>
                <TextBlock x:Name="MenuSummary" Style="{StaticResource BodyText}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <Grid x:Name="MenuHost" Margin="0,0,0,40">
                    <Border x:Name="MenuHighlight" CornerRadius="12" Background="#24FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                    <StackPanel x:Name="Menu"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ====== Réglages de la catégorie ====== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="18,0,0,18">
                <TextBlock x:Name="CategoryTitle" Style="{StaticResource H1}" FontSize="34"/>
                <TextBlock x:Name="CategorySummary" Style="{StaticResource BodyText}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer x:Name="Scroll" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <Grid x:Name="ItemsHost" Margin="0,0,0,60">
                    <Border x:Name="ItemsHighlight" CornerRadius="12" Background="#24FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                    <StackPanel x:Name="Items"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ====== Aide contextuelle de la ligne sélectionnée ====== -->
        <Border Grid.Column="4" VerticalAlignment="Top" CornerRadius="16" Padding="26,22" Margin="0,64,0,0"
                Background="{StaticResource SurfaceGlass}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="HelpTitle" Style="{StaticResource H2}" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock x:Name="HelpText" Style="{StaticResource BodyText}" FontSize="15" Margin="0,10,0,0"/>
                <!-- Raccourci manette vers le site de la ligne sélectionnée -->
                <Border x:Name="LinkHint" Visibility="Collapsed" Margin="0,18,0,0" HorizontalAlignment="Left" Cursor="Hand"
                        CornerRadius="20" Padding="8,7,18,7" Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        MouseLeftButtonUp="LinkHint_Click">
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource PadGlyph}" Margin="0,0,10,0">
                            <TextBlock Text="Y" Style="{StaticResource PadGlyphText}" Foreground="#FFD24D"/>
                        </Border>
                        <TextBlock x:Name="LinkHintText" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
