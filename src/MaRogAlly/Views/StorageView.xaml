<v:OverlayBase x:Class="MaRogAlly.Views.StorageView"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <Grid Background="{DynamicResource Bg}">
        <!-- Lueur d'ambiance à la couleur d'accent -->
        <Ellipse Width="1400" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-600,-500,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{DynamicResource AccentGlowColor}" Offset="0"/>
                    <GradientStop Color="{DynamicResource AccentClearColor}" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Rectangle Fill="{StaticResource BackdropPattern}" IsHitTestVisible="False"/>

        <Grid x:Name="Root" Margin="64,30,64,62">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====== En-tête : titre et choix du disque ====== -->
            <Grid Grid.ColumnSpan="3" Margin="0,0,0,18">
                <StackPanel Margin="18,0,0,0">
                    <TextBlock Text="Stockage" Style="{StaticResource H1}" FontSize="34"/>
                    <TextBlock x:Name="Summary" Style="{StaticResource BodyText}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="DriveBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border x:Name="PrevDrive" Style="{StaticResource PadGlyph}" Margin="0,0,10,0" Cursor="Hand" MouseLeftButtonUp="PrevDrive_Click">
                        <TextBlock Text="LB" Style="{StaticResource PadGlyphText}"/>
                    </Border>
                    <StackPanel x:Name="DriveChips" Orientation="Horizontal"/>
                    <Border x:Name="NextDrive" Style="{StaticResource PadGlyph}" Margin="2,0,0,0" Cursor="Hand" MouseLeftButtonUp="NextDrive_Click">
                        <TextBlock Text="RB" Style="{StaticResource PadGlyphText}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ====== Sections et état de l'analyse ====== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="MenuHost">
                    <Border x:Name="MenuHighlight" CornerRadius="14" Background="Transparent" BorderBrush="#E6FFFFFF" BorderThickness="2"/>
                    <StackPanel x:Name="Menu"/>
                </Grid>
                <Border Grid.Row="1" VerticalAlignment="Bottom" CornerRadius="16" Padding="18,14,18,16" Margin="0,14,0,0"
                        Background="{StaticResource SurfaceClear}" BorderBrush="{StaticResource StrokeClear}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="ScanTitle" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="ScanDetail" FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <Grid x:Name="ScanTrack" Height="4" Margin="0,10,0,0" Visibility="Collapsed">
                            <Border CornerRadius="2" Background="#1FFFFFFF"/>
                            <Border x:Name="ScanFill" CornerRadius="2" Background="{DynamicResource Accent}" HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                        <StackPanel x:Name="RescanHint" Orientation="Horizontal" Margin="0,10,0,0" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="Rescan_Click">
                            <Border Style="{StaticResource PadGlyph}">
                                <TextBlock Text="X" Style="{StaticResource PadGlyphText}" Foreground="#4DA3FF"/>
                            </Border>
                            <TextBlock Text="Analyser à nouveau" FontSize="13" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ====== Contenu de la section ====== -->
            <ScrollViewer x:Name="Scroll" Grid.Row="1" Grid.Column="2" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                <Grid x:Name="ItemsHost" Margin="0,0,0,12">
                    <Border x:Name="Highlight" CornerRadius="14" Background="Transparent" BorderBrush="#E6FFFFFF" BorderThickness="2"/>
                    <StackPanel x:Name="Items"/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</v:OverlayBase>
