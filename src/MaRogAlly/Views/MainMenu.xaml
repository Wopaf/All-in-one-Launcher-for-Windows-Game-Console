<v:OverlayBase x:Class="MaRogAlly.Views.MainMenu"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <Grid>
        <Rectangle Fill="#99000000" MouseLeftButtonUp="Backdrop_Click"/>
        <!-- Panneau flottant, comme le centre de contrôle et le menu Démarrer : coins arrondis, marge, contour léger -->
        <Grid x:Name="Panel" Width="470" HorizontalAlignment="Right" Margin="14">
            <!-- Fond opaque (couleur du thème) portant l'ombre : elle n'est pas recalculée quand le contenu s'anime -->
            <Border CornerRadius="22" Background="{DynamicResource Bg}" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="36" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
            </Border>
            <Border CornerRadius="22" Background="{DynamicResource PanelBg}" BorderBrush="{StaticResource PanelStroke}" BorderThickness="1">
            <Grid Margin="28,30,28,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ====== Tuiles (le cadre de sélection glisse de l'une à l'autre) ====== -->
                <ScrollViewer x:Name="Scroll" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <Grid x:Name="ItemsHost" Margin="0,0,0,12">
                        <Border x:Name="Highlight" CornerRadius="14" Background="Transparent" BorderBrush="{DynamicResource Accent}" BorderThickness="2"/>
                        <StackPanel x:Name="Items" KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</v:OverlayBase>
