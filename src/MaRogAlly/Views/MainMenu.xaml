<v:OverlayBase x:Class="MaRogAlly.Views.MainMenu"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <Grid>
        <Rectangle Fill="#99000000" MouseLeftButtonUp="Backdrop_Click"/>
        <Grid x:Name="Panel" Width="540" HorizontalAlignment="Right">
            <!-- Ombre en dégradé plutôt qu'en effet de flou, recalculé à chaque image de l'ouverture -->
            <Border Width="70" Margin="-70,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#8C000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Fond opaque : la couleur du thème sous la teinte (translucide) des panneaux -->
            <Border Background="{DynamicResource Bg}"/>
            <Border Background="{DynamicResource PanelBg}">
            <Grid Margin="36,40,36,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ====== Tuiles (le cadre de sélection glisse de l'une à l'autre) ====== -->
                <ScrollViewer x:Name="Scroll" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <Grid x:Name="ItemsHost" Margin="0,0,0,12">
                        <Border x:Name="Highlight" CornerRadius="14" Background="Transparent" BorderBrush="#E6FFFFFF" BorderThickness="2"/>
                        <StackPanel x:Name="Items" KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
            </Border>
        </Grid>
    </Grid>
</v:OverlayBase>
