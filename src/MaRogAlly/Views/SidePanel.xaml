<v:OverlayBase x:Class="MaRogAlly.Views.SidePanel"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:v="clr-namespace:MaRogAlly.Views">
    <Grid>
        <Rectangle Fill="#99000000" MouseLeftButtonUp="Backdrop_Click"/>
        <Border x:Name="Panel" Width="470" HorizontalAlignment="Right" Background="{DynamicResource PanelBg}">
            <Grid Margin="30,36,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="Header" Margin="18,0,0,22">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="28"/>
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource BodyText}" FontSize="14" Margin="0,4,0,0"/>
                </StackPanel>
                <ScrollViewer x:Name="Scroll" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                    <Grid x:Name="ItemsHost">
                        <Border x:Name="Highlight" CornerRadius="12" Background="#24FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1"/>
                        <StackPanel x:Name="Items" KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</v:OverlayBase>
